{
  "name": "pink-beauty-salon",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "version:show": "node -p \"require('./package.json').version\"",
    "catalog:import": "node scripts/import-west-street-catalog.mjs",
    "catalog:import:west-street": "node scripts/import-west-street-catalog.mjs",
    "catalog:seed:sanity": "node --env-file=.env.local scripts/seed-west-street-catalog-to-sanity.mjs",
    "catalog:images:sanity": "node --env-file=.env.local scripts/import-catalog-images-to-sanity.mjs",
    "release:patch": "npm version patch -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:major": "npm version major -m \"release: %s\"",
    "release:push": "git push origin main --follow-tags",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_booking_system.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@sanity/client": "^7.24.0",
    "@sanity/image-url": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "^16.2.11",
    "next-sanity": "^13.1.5",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.5.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.21",
    "smol-toml": "^1.6.1",
    "uuid": "^11.1.1"
  }
}
