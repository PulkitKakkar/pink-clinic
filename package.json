{
  "name": "pink-beauty-salon",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "version:show": "node -p \"require('./package.json').version\"",
    "catalog:import": "node scripts/import-west-street-catalog.mjs",
    "catalog:import:west-street": "node scripts/import-west-street-catalog.mjs",
    "catalog:seed:sanity": "node --env-file=.env.local scripts/seed-west-street-catalog-to-sanity.mjs",
    "catalog:images:sanity": "node --env-file=.env.local scripts/import-catalog-images-to-sanity.mjs",
    "release:patch": "npm version patch -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:major": "npm version major -m \"release: %s\"",
    "release:push": "git push origin main --follow-tags",
    "db:migrate": "node scripts/migrate-database.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@sanity/client": "^8.3.0",
    "@sanity/image-url": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-sanity": "^13.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.11.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.21",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.21",
    "smol-toml": "^1.6.1",
    "uuid": "^11.1.1"
  }
}
