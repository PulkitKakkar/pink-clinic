NEXT_PUBLIC_SITE_URL=https://pinkclinic.co.uk
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Developer-only write token for the catalogue seed/image import scripts. Do not expose it as NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=
ENQUIRY_WEBHOOK_URL=
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=Pink Beauty Website <info@pinkbeautysalons.co.uk>
GETADDRESS_API_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production
ADMIN_SESSION_TOKEN=replace-with-a-long-random-secret
ACADEMY_ADMIN_EMAIL=academy-admin@example.com
ACADEMY_ADMIN_PASSWORD=change-this-before-production
ACADEMY_ADMIN_SESSION_TOKEN=replace-with-a-separate-long-random-secret
STUDIO_ADMIN_EMAIL=studio-admin@example.com
STUDIO_ADMIN_PASSWORD=change-this-before-production
STUDIO_ADMIN_SESSION_TOKEN=replace-with-a-different-long-random-secret
DATABASE_URL=
TREATMENT_IMAGES_REGION=eu-west-2
TREATMENT_IMAGES_BUCKET=
LEARNER_FILES_REGION=eu-west-2
LEARNER_FILES_BUCKET=
CRON_SECRET=replace-with-a-long-random-secret
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Instagram Professional account credentials used for the homepage feed.
# Generate tokens in the Meta developer dashboard. Never expose these as NEXT_PUBLIC variables.
INSTAGRAM_WEST_STREET_ACCOUNT_ID=
INSTAGRAM_WEST_STREET_ACCESS_TOKEN=
INSTAGRAM_WATLINGTON_STREET_ACCOUNT_ID=
INSTAGRAM_WATLINGTON_STREET_ACCESS_TOKEN=

# Live Google reviews from both branches. Enable Places API (New) for the key.
GOOGLE_PLACES_API_KEY=
GOOGLE_WEST_STREET_PLACE_ID=
GOOGLE_WATLINGTON_STREET_PLACE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
